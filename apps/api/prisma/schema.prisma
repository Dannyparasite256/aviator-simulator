generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RoundPhase {
  WAITING
  COUNTDOWN
  FLYING
  CRASHED
}

enum RoundEventType {
  PHASE_CHANGE
  MULTIPLIER_TICK
  CRASH
  SIM_PLAYER_CASH_OUT
  PRACTICE_BET
  PRACTICE_CASH_OUT
  PRACTICE_PARTIAL_CASH_OUT
  PRACTICE_CANCEL
  LIVE_BET
}

enum PracticeBetStatus {
  QUEUED
  ACTIVE
  CASHED_OUT
  BUSTED
  CANCELLED
}

enum WalletRequestType {
  DEPOSIT
  WITHDRAW
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  displayName        String
  role               Role           @default(USER)
  virtualCredits     Decimal        @default(10000) @db.Decimal(18, 2)
  preferredCurrency  String         @default("UGX")
  clientSeed         String         @default("aviator-default-client")
  minBet             Decimal        @default(1) @db.Decimal(18, 2)
  maxBet             Decimal        @default(100000) @db.Decimal(18, 2)
  maxProfitPerBet    Decimal        @default(1000000) @db.Decimal(18, 2)
  sessionLossLimit   Decimal?       @db.Decimal(18, 2)
  sessionTimeLimitMin Int?
  sessionStartedAt   DateTime?
  sessionProfit      Decimal        @default(0) @db.Decimal(18, 2)
  refreshTokenHash   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  practiceBets       PracticeBet[]
  analyticsEvents    AnalyticsEvent[]
  bankrollSnapshots  BankrollSnapshot[]
  walletRequests     WalletRequest[]
  notifications      Notification[]
  promoRedemptions   PromoRedemption[]

  @@index([role])
  @@map("users")
}

/// Virtual display currencies (NOT real money). Rates convert to VC (virtual credits).
model Currency {
  code        String   @id
  name        String
  symbol      String
  /// How many VC per 1 unit of this currency
  rateToVc    Decimal  @db.Decimal(18, 6)
  decimals    Int      @default(2)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("currencies")
}

/// Simulated deposit/withdraw requests — admin-approved virtual ledger only.
model WalletRequest {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            WalletRequestType
  status          WalletRequestStatus @default(PENDING)
  currencyCode    String
  amountCurrency  Decimal             @db.Decimal(18, 6)
  amountVc        Decimal             @db.Decimal(18, 2)
  note            String?
  adminNote       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("wallet_requests")
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  bonusVc     Decimal  @db.Decimal(18, 2)
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id        String   @id @default(uuid())
  promoId   String
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonusVc   Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([promoId, userId])
  @@index([userId])
  @@map("promo_redemptions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Round {
  id              String        @id @default(uuid())
  roundNumber     Int           @unique @default(autoincrement())
  phase           RoundPhase    @default(WAITING)
  crashPoint      Decimal?      @db.Decimal(12, 2)
  serverSeed      String
  serverSeedHash  String
  clientSeed      String
  nonce           Int
  startedAt       DateTime?
  crashedAt       DateTime?
  durationMs      Int?
  peakMultiplier  Decimal?      @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  events          RoundEvent[]
  practiceBets    PracticeBet[]

  @@index([createdAt])
  @@index([phase])
  @@map("rounds")
}

model RoundEvent {
  id         String         @id @default(uuid())
  roundId    String
  round      Round          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  type       RoundEventType
  multiplier Decimal?       @db.Decimal(12, 2)
  payload    Json           @default("{}")
  createdAt  DateTime       @default(now())

  @@index([roundId, createdAt])
  @@map("round_events")
}

model PracticeBet {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId            String?
  round              Round?            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  slot               Int               @default(1)
  amount             Decimal           @db.Decimal(18, 2)
  remainingAmount    Decimal           @db.Decimal(18, 2)
  autoCashOutAt      Decimal?          @db.Decimal(12, 2)
  status             PracticeBetStatus @default(ACTIVE)
  cashedOut          Boolean           @default(false)
  cashOutMultiplier  Decimal?          @db.Decimal(12, 2)
  profit             Decimal?          @db.Decimal(18, 2)
  partialProfit      Decimal           @default(0) @db.Decimal(18, 2)
  queued             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, status])
  @@index([roundId])
  @@index([userId, slot, status])
  @@map("practice_bets")
}

model SimulationConfig {
  id        String   @id @default("default")
  settings  Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("simulation_config")
}

model SimulatedPlayer {
  id            String   @id @default(uuid())
  name          String
  avatarHue     Int      @default(200)
  active        Boolean  @default(true)
  personality   String   @default("mixed")
  lastBetAmount Decimal? @db.Decimal(18, 2)
  lastCashOutAt Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("simulated_players")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  String
  action    String
  label     String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  resource  String
  details   Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model BankrollSnapshot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankroll  Decimal  @db.Decimal(18, 2)
  profit    Decimal  @db.Decimal(18, 2)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("bankroll_snapshots")
}
