# Copy to .env and fill before production deploy
# cp .env.example .env

# --- Public URLs (browser must reach these) ---
# Local Docker: http://localhost:3000 and http://localhost:4000
# Production: https://your-domain.com and https://api.your-domain.com
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- API ---
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://aviator:CHANGE_ME_DB_PASSWORD@postgres:5432/aviator?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_long_random_string_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
GAME_TICK_MS=16
LOG_LEVEL=info

# --- Postgres (docker-compose) ---
POSTGRES_USER=aviator
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=aviator
